# Public Flickr searches require an application key, not an API secret.
FLICKR_API_KEY=
ATIA_DB_PATH=data/atia.sqlite3

# Optional standalone live promotional search. Do not paste this key into source.
BRAVE_SEARCH_API_KEY=

# Live authoritative identity and coverage search (never commit a real key).
TAVILY_API_KEY=

# Phase 6: local secrets only. No batch agent execution is provided.
OPENAI_API_KEY=
ATIA_AGENT_MODEL=gpt-4o-mini
ATIA_AGENT_MAX_STEPS=4
ATIA_AGENT_MAX_TOOL_CALLS=3
ATIA_AGENT_MAX_OUTPUT_TOKENS=1800
ATIA_AGENT_RUN_BUDGET_USD=0.05
ATIA_AGENT_LIFETIME_BUDGET_USD=0.25
ATIA_AGENT_MAX_SEARCHES=1
